# Initial admin password for a fresh database.
# If omitted, the app generates a temporary password and prints it once at startup.
ESCALA_ADMIN_PASSWORD=change-me-before-shared-use

# Local server port.
ESCALA_PORT=8766

# Optional: first date allowed for generated schedules (YYYY-MM-DD).
NEW_SCHEDULE_START=

# Optional: protect existing schedule dates through this day (YYYY-MM-DD).
SCHEDULE_CUTOFF=

# Optional: external SQLite directory/database used only for employee synchronization.
CENTRAL_DB_PATH=
